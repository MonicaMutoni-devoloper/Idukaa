# Copy to apps/api/.env and fill in. NEVER commit real values.
DATABASE_URL=postgres://sms:CHANGE_ME@localhost:5432/sms
# Production (Neon): DATABASE_URL = pooled connection string (append ?sslmode=require), used by the API.
# DIRECT_URL     = direct (non-pooler) connection string, used ONLY by `npm run migrate`.
#DIRECT_URL=postgres://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# Access tokens are short-lived; clients rotate refresh tokens to stay signed in.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_48_CHARS
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
PORT=3000
# Exact web origins allowed to call this API with credentials (comma separated, no trailing slash).
# On a cross-site deployment this list is also the CSRF defence: the browser sets Origin itself and a
# cross-site page cannot send the x-csrf-token header without an approved preflight.
CORS_ORIGINS=http://localhost:8081

# Two-factor authentication. 32 random bytes, base64 (44 chars) or 64 hex characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 2FA cannot be enabled while this is missing (the API fails closed and says so).
TOTP_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_BASE64_OR_64_HEX
TWO_FACTOR_CHALLENGE_MINUTES=5

# ------------------------------------------------------------------ e-mail (confirmation + reset)
# One real mailbox sends all of it. Gmail over SMTP needs an APP PASSWORD (Google Account ->
# Security -> 2-Step Verification -> App passwords), never the account password:
#   MAIL_SMTP_USER = the full Gmail address,  MAIL_SMTP_PASS = the 16-character app password.
# Gmail delivers to Gmail and passes SPF/DKIM without a domain. Limits: ~500 recipients/day.
# With these unset the API still runs: sign-in confirmations and reset links are logged as skipped
# instead of sent, and EMAIL_VERIFICATION_REQUIRED=false is the way out if mail breaks.
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=465
MAIL_SMTP_USER=CHANGE_ME@gmail.com
MAIL_SMTP_PASS=CHANGE_ME_16_CHAR_APP_PASSWORD
MAIL_FROM_NAME=Idukaa
#MAIL_FROM=CHANGE_ME@gmail.com

# The deployed web app. Every link in an e-mail points here (verify-email, reset-password).
# In production this MUST be set: the API cannot guess the web origin, and a link to localhost is a
# dead end for the user.
APP_WEB_URL=http://localhost:8081
EMAIL_VERIFICATION_TTL_HOURS=48
# true = an account cannot sign in until its address has been confirmed by clicking the link.
# Set false only as an emergency escape hatch (a mailbox outage) — never permanently.
EMAIL_VERIFICATION_REQUIRED=true

# Password reset. PASSWORD_RESET_URL is the web page that receives ?token=... (defaults to
# APP_WEB_URL/reset-password when unset).
PASSWORD_RESET_URL=http://localhost:8081/reset-password
PASSWORD_RESET_TTL_MINUTES=30
# Development/test ONLY: returns the reset link in the API response (and logs it locally).
# Ignored when NODE_ENV=production.
PASSWORD_RESET_DEV_MODE=false

# Set true when the API is served over HTTPS so the refresh cookie is Secure in same-site setups.
# (request.secure / X-Forwarded-Proto also enables it automatically behind a proxy, and a
# cross-site cookie is always Secure.)
COOKIE_SECURE=false
# SameSite for the auth cookies is derived PER REQUEST from the caller's Origin:
#   same registrable domain (app.example.rw -> api.example.rw) ... strict
#   different sites (*.vercel.app -> *.onrender.com) ............. none + Secure
# A hard-coded "strict" on a cross-site deployment is the bug that made POST /auth/refresh return
# 401 forever: browsers do not attach a Strict cookie to a cross-site request at all.
# Leave this UNSET to keep the automatic behaviour; set strict|lax|none only to override it.
#COOKIE_SAMESITE=
# How long a just-rotated refresh token may still be presented by the same browser before it counts
# as theft (0 disables the grace window and restores immediate family revocation). 120s covers a
# rotation whose response was lost when a phone's connection dropped mid-answer.
REFRESH_REUSE_GRACE_SECONDS=120

# Mobile/web app (apps/mobile/.env)
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
