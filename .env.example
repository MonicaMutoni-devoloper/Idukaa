# Copy to apps/api/.env and fill in. NEVER commit real values.
DATABASE_URL=postgres://sms:CHANGE_ME@localhost:5432/sms
# Production (Neon): DATABASE_URL = pooled connection string (append ?sslmode=require), used by the API.
# DIRECT_URL     = direct (non-pooler) connection string, used ONLY by `npm run migrate`.
#DIRECT_URL=postgres://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# Access tokens are short-lived; clients rotate refresh tokens to stay signed in.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_48_CHARS
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
PORT=3000
CORS_ORIGINS=http://localhost:8081

# Two-factor authentication. 32 random bytes, base64 (44 chars) or 64 hex characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 2FA cannot be enabled while this is missing (the API fails closed and says so).
TOTP_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_BASE64_OR_64_HEX
TWO_FACTOR_CHALLENGE_MINUTES=5

# Password reset. No e-mail provider is configured in this repository.
# PASSWORD_RESET_URL is the web page that receives ?token=...
PASSWORD_RESET_URL=http://localhost:8081/reset-password
PASSWORD_RESET_TTL_MINUTES=30
# Development/test ONLY: returns the reset link in the API response (and logs it locally).
# Ignored when NODE_ENV=production. Leave false in production: recovery then needs a provider.
PASSWORD_RESET_DEV_MODE=false

# Set true when the API is served over HTTPS so the refresh cookie is Secure.
# (request.secure / X-Forwarded-Proto also enables it automatically behind a proxy.)
COOKIE_SECURE=false

# Mobile/web app (apps/mobile/.env)
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
