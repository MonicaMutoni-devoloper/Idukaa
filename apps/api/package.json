    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "10.4.4",
    "@nestjs/core": "10.4.4",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/platform-express": "10.4.4",
    "@nestjs/throttler": "6.2.1",
    "@sms/shared": "*",
    "bcryptjs": "2.4.3",
    "helmet": "7.1.0",
    "otplib": "^12.0.1",
    "pg": "8.12.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.5",
    "@types/bcryptjs": "2.4.6",
    "@types/express": "4.17.21",
    "@types/node": "22.5.4",
    "@types/pg": "8.11.8",
    "@types/qrcode": "^1.5.5",
    "tsx": "4.19.1",
    "typescript": "5.7.3"
