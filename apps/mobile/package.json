{
  "name": "@sms/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "node scripts/check-api-url.mjs && expo export --platform web",
    "test:i18n": "node --test tests/i18n.test.mts",
    "test:dashboard": "node --test tests/local-dashboard.test.mts tests/dashboard-cache.test.mts",
    "test:reports": "node --test tests/local-reports.test.mts tests/report-analytics.test.mts tests/report-format.test.mts",
    "test:realtime": "node --test tests/realtime.test.mts",
    "test:policy": "node --test tests/session-policy.test.mts",
    "test:sections": "node --test tests/report-sections.test.mts",
    "test:roles": "node --test tests/permissions.test.mts",
    "test:sync": "node --test tests/schema-out-of-date.test.mts",
    "test:update": "node --test tests/app-update.test.mts",
    "test:catalogue": "node --test tests/catalogue.test.mts",
    "test:pwa": "node --test tests/pwa.test.mts",
    "test:intro": "node --test tests/intro.test.mts",
    "test:sell": "node --test tests/sell-quick-add.test.mts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-native-community/netinfo": "12.0.1",
    "@sms/shared": "*",
    "expo": "~58.0.0",
    "expo-constants": "~58.0.4",
    "expo-crypto": "~58.0.7",
    "expo-linking": "~58.0.14",
    "expo-print": "~58.0.8",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "query-string": "^7.1.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4",
    "zustand": "5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
